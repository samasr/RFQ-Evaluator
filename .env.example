# ─── AI proxy (existing) ─────────────────────────────────────────────────────
# Public URL of the deployed Cloudflare Worker AI proxy (see /worker).
# Not a secret — just an endpoint. The Anthropic key lives only in the Worker.
VITE_AI_PROXY_URL=https://rfq-evaluator-ai-proxy.<your-subdomain>.workers.dev

# ─── Supabase auth + database (Phase 7a) ─────────────────────────────────────
# Leave BOTH unset to run the app in "local mode": no accounts, no route
# protection, evaluations in localStorage, every feature unlocked (i.e. how the
# app worked before Phase 7). Set both to enable auth, plans, and cloud storage.
# Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# ─── Payments (Phase 7b) ─────────────────────────────────────────────────────
# Publishable keys only — safe in the browser. Leave unset to hide that
# payment option on /checkout. The matching SECRET keys go on the Cloudflare
# Worker via `wrangler secret put` (see worker/wrangler.toml), never here.
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
