# Public URL of the deployed Cloudflare Worker AI proxy (see /worker).
# This is NOT a secret — it's just an endpoint URL, safe to build into the
# public site. The actual Anthropic API key lives only in the Worker's
# environment (set via `wrangler secret put ANTHROPIC_API_KEY`), never here.
VITE_AI_PROXY_URL=https://rfq-evaluator-ai-proxy.<your-subdomain>.workers.dev
